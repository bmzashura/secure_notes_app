<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  S8 Hardening: Hanya izinkan HTTPS ke backend API.
  Untuk development, localhost (emulator) diizinkan.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Izinkan localhost untuk development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>  <!-- Android emulator localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
