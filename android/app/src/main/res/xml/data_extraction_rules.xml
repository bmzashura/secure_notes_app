<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml
  S8 Hardening: Disable all backup — tidak ada data yang di-backup
  oleh Android Auto Backup atau adb backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Tidak ada file atau direktori yang di-backup -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow transfer only for non-sensitive data if needed -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
